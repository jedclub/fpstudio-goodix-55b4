# Build output
# Local investigation originals and device-specific secrets; never publish.
/local-private/
device-secrets.txt

# All CMake build trees, including local PGO variants.  Keeping this broad is
# important because CMake records absolute user paths and host details.
/build*/
src/fpstudio/build*/
*.o
*.so
*.so.*
*.a

# Compiled translations. The .ts sources are committed and reviewable; the .qm
# are binary and are produced by lrelease during the build.
*.qm

# Arch packaging leftovers. makepkg extracts sources into src/ and stages the
# package in pkg/, both inside the driver directory - neither belongs in git,
# and src/ in particular is a full libfprint checkout.
src/driver/src/
src/driver/pkg/
# This directory is the local Git metadata checkout used while building the
# patched driver; it is not a source snapshot to publish.
src/driver/libfprint-goodixtls-55x4/
*.pkg.tar.zst
*.pkg.tar.xz
*.log

# Captures. Anything the sensor actually produced is biometric data and must
# not be committed - not a frame, not a template, not a debug dump. The
# synthetic illustrations in captures/ are committed by name, so a real capture
# written there with any other name is ignored by default rather than by
# remembering to.
# The order matters: a negation cannot rescue a file whose directory was
# excluded, so the directory itself is never excluded - only its contents, and
# then the three names that belong here are put back.
captures/**
!captures/README.md
!captures/ridges-correct-geometry.png
!captures/ridges-wrong-geometry.png
!captures/normalisation-minmax.png
!captures/normalisation-percentile.png
*.pgm

# Enrolment templates, wherever they land. Same reason, more so - a template is
# derived directly from the finger.
*.fp

# Editor and tooling droppings
.cache/
.vscode/
.idea/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
compile_commands.json
*.swp
*~

# Per-user coding-agent state.  Project instructions such as AGENTS.md remain
# trackable; these are only local sessions, account connections, and caches.
/.codex/
/.claude/
/.cursor/
/.aider/
/.continue/
/.roo/
/.windsurf/
/.agent/
/.agents/
/.qt/

# Never publish credentials or machine-local account configuration.  Examples
# remain explicitly trackable so setup can still be documented safely.
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
*.token
/credentials.json
/auth.json
/token.json
