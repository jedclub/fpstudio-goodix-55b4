#%PAM-1.0
#
# Let sudo accept a fingerprint, falling back to the password.
#
# This file shadows the system's /etc/pam.d/sudo, which is the same three
# lines here without the fingerprint one. Overriding in /etc means a system
# update cannot silently drop the change, and reverting is deleting one file.
#
# max-tries=10, timeout=90: stop after at most ten authentication attempts.
# Timeout or device failure may end fingerprint authentication earlier.
# Retries are not independent evidence and do not guarantee recognition.
# `sufficient` is what makes this safe: if pam_fprintd fails for any reason -
# sensor unplugged, driver broken, no finger enrolled - PAM falls through to
# system-auth and asks for the password exactly as before. sudo itself never
# stops working; only the fingerprint shortcut can.
#
# This is a step further than the polkit rule this project installs by
# default. polkit failing leaves the desktop's own password dialog and a TTY
# login as ways back in; sudo IS one of those ways back in, so it is worth
# being more deliberate about extending fingerprint auth to it. The
# `sufficient` fallback is the same safety net either way - a broken sensor
# degrades to a password prompt, never to a lockout - but sudo is the last
# resort if something else on the machine is broken, which is why this file
# is a separate, opt-in step rather than bundled into the default one.
#
# Install:
#   sudo install -Dm644 admin-auth-notice.txt /etc/security/fpstudio-admin-auth.txt
#   sudo install -Dm644 sudo /etc/pam.d/sudo
#
# Remove:
#   sudo rm /etc/pam.d/sudo
#   (or restore the original three lines by hand)
#
# No daemon restart is needed; PAM reads the stack per authentication.

# Informational only: ignore every return code; never grant or deny access.
auth [default=ignore] pam_echo.so file=/etc/security/fpstudio-admin-auth.txt
auth		sufficient	pam_fprintd.so max-tries=10 timeout=90
auth		include		system-auth
account		include		system-auth
session		include		system-auth
session		optional	pam_systemd.so class=none
