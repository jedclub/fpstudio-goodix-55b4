+/* Opt-in diagnostic stream. Never used by normal enrollment/authentication.
+ * One atomically replaced private PGM, no growing biometric video archive.
+ * Reuse the established FDT/read sequence and the same empty calibration. */
+static gboolean preview_frame(FpDevice *dev, FpiSsm *ssm,
+                              const Goodix55X4Pix *candidate, double diff) {
+  const char *path = g_getenv("GOODIX55X4_PREVIEW_PATH");
+  if (!path || !*path)
+    return FALSE;
+  gint64 *start = g_object_get_data(G_OBJECT(dev), "preview-start");
+  if (!start) {
+    start = g_new(gint64, 1);
+    *start = g_get_monotonic_time();
+    g_object_set_data_full(G_OBJECT(dev), "preview-start", start, g_free);
+  }
+  g_autofree char *stop = g_strconcat(path, ".stop", NULL);
+  if (g_file_test(stop, G_FILE_TEST_EXISTS) ||
+      g_get_monotonic_time() - *start > 180 * G_USEC_PER_SEC) {
+    fpi_ssm_mark_completed(ssm);
+    fpi_image_device_session_error(FP_IMAGE_DEVICE(dev),
+        fpi_device_error_new_msg(FP_DEVICE_ERROR_GENERAL, "Live preview ended"));
+    return TRUE;
+  }
+  Goodix55X4Pix corrected[GOODIX55X4_FRAME_SIZE];
+  guint8 pixels[GOODIX55X4_FRAME_SIZE];
+  memcpy(corrected, candidate, sizeof(corrected));
+  postprocess_frame(corrected, FPI_DEVICE_GOODIXTLS55X4(dev)->empty_img);
+  squash_frame_linear(corrected, pixels);
+  guint metrics[2];
+  assess_image(pixels, metrics);
+  g_autofree char *header = g_strdup_printf("P5\n# %" G_GINT64_FORMAT " %.1f %u %u\n%d %d\n255\n",
+      g_get_monotonic_time(), diff, metrics[0], metrics[1],
+      GOODIX55X4_WIDTH, GOODIX55X4_HEIGHT);
+  gsize size = strlen(header) + sizeof(pixels);
+  g_autofree char *packet = g_malloc(size);
+  memcpy(packet, header, strlen(header));
+  memcpy(packet + strlen(header), pixels, sizeof(pixels));
+  GError *error = NULL;
+  if (!g_file_set_contents_full(path, packet, size,
+                               G_FILE_SET_CONTENTS_CONSISTENT, 0600, &error)) {
+    fpi_ssm_mark_completed(ssm);
+    fpi_image_device_session_error(FP_IMAGE_DEVICE(dev), error);
+    return TRUE;
+  }
+  fpi_device_add_timeout(dev, 1, preview_next_frame, ssm, NULL);
+  return TRUE;
+}
