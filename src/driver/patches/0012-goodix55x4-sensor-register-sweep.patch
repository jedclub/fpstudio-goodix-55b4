+/* Diagnostic sweep of the sensor's register space. Off unless
+ * GOODIX55X4_SWEEP is set in the environment, because it costs about twelve
+ * seconds on every activation and answers a question that has already been
+ * answered - see below.
+ *
+ * What it was for: GOODIX_CMD_READ_OTP (0xa6) answers with 32 bytes on this
+ * device, and that is the MCU's own area, not the one carrying the analog
+ * operating point. Three things say so. The vendor's Milan F-series CheckOtp
+ * accepts only 64 bytes (a plain `cmp ..., 0x40`), its parser reads indices
+ * 0x28 to 0x2e - past the end of what 0xa6 returns - and the sibling goodix511
+ * driver in this tree likewise rejects an OTP shorter than 64 and uses bytes
+ * 46-49. The vendor reaches its OTP over SPI (MilanFSerSpiGetOtp,
+ * _ReadOneByteOtp) rather than through the MCU command at all, and the routine
+ * that sets that transfer up loads 0x0d00 into its descriptor.
+ *
+ * 0x0d00 read back as 64 bytes of zero - the command works, the window is
+ * simply empty - so this swept everything from 0 to 0x8000 in 64-byte steps.
+ * Result: seven non-empty windows, all below 0x0240, and nothing whatsoever
+ * above 0x1000. What is there does not look like an OTP either; the repeated
+ * 0x28 runs at 0x0080 read as live DAC-shaped configuration, and 0x0200 covers
+ * exactly the registers goodix511 writes during activation. This is the space
+ * that gets written to, not a per-die constant.
+ *
+ * So the calibration OTP is not reachable this way, and reaching it means
+ * decoding the vendor's bit-banged SPI sequence. The sweep stays because it is
+ * how that was established and the next person will want to re-run it against
+ * different hardware, not because the driver needs it.
+ *
+ * Read-only and non-fatal throughout: a failed read is logged and the sweep
+ * moves on, nothing is written, and activation continues either way. */
+#define GOODIX55X4_SWEEP_START 0x0000
+#define GOODIX55X4_SWEEP_END 0x8000
+#define GOODIX55X4_SWEEP_STEP 64
+
+static guint16 g_sweep_addr;
+static guint g_sweep_hits;
+
+static void sweep_step(FpDevice *dev, FpiSsm *ssm);
+
+static void sweep_callback(FpDevice *dev, guint8 *data, guint16 length,
+                           gpointer user_data, GError *error) {
+  FpiSsm *ssm = user_data;
+  const guint16 addr = g_sweep_addr;
+
+  if (error) {
+    g_print("sweep 0x%04x: read failed (%s)\n", addr, error->message);
+    g_error_free(error);
+  } else if (data && length) {
+    gboolean any = FALSE;
+    for (guint16 i = 0; i < length; i++)
+      if (data[i]) {
+        any = TRUE;
+        break;
+      }
+    if (any) {
+      GString *hex = g_string_new(NULL);
+      for (guint16 i = 0; i < length; i++)
+        g_string_append_printf(hex, "%02x", data[i]);
+      g_print("sweep 0x%04x: %u bytes %s\n", addr, length, hex->str);
+      g_string_free(hex, TRUE);
+      g_sweep_hits++;
+    }
+  }
+
+  g_sweep_addr += GOODIX55X4_SWEEP_STEP;
+  if (g_sweep_addr >= GOODIX55X4_SWEEP_END) {
+    g_print("sweep done: %u non-empty windows\n", g_sweep_hits);
+    fpi_ssm_next_state(ssm);
+    return;
+  }
+  sweep_step(dev, ssm);
+}
+
+static void sweep_step(FpDevice *dev, FpiSsm *ssm) {
+  goodix_send_read_sensor_register(dev, g_sweep_addr, GOODIX55X4_SWEEP_STEP,
+                                   sweep_callback, ssm);
+}
